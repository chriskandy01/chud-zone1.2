        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Log cardio",
      "short_name": "Cardio",
      "url": "./index.html?go=cardio",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "See progress",
      "short_name": "Stats",
      "url": "./index.html?go=stats",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
